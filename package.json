{
  "name": "kitchen-design-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "e2e": "playwright test",
    "cap:sync": "cap sync android",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "import:local": "tsx --env-file-if-exists=.env.local scripts/import-local-data.ts",
    "create-user": "tsx --env-file-if-exists=.env.local scripts/create-user.ts",
    "capacitor:copy:after": "node scripts/inline-server-url.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@google-cloud/storage": "^8.4.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@sentry/browser": "^11.12.0",
    "@sentry/node": "^11.10.0",
    "drizzle-orm": "^0.45.4",
    "fast-json-patch": "^3.1.1",
    "konva": "^9.3.16",
    "next": "^15.5.0",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-konva": "~19.3.2",
    "sharp": "^0.35.5",
    "three": "^0.187.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@electric-sql/pglite": "^0.5.16",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.7.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.6.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "happy-dom": "^15.10.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
