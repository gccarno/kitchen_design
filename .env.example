# LLM provider — must be OpenAI-compatible (OpenAI, OpenRouter, Groq, llama.cpp, …)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-replace-me
LLM_MODEL=gpt-4o-mini
LLM_VISION_MODEL=gpt-4o-mini

# OpenRouter example — models may be comma-separated lists: the first is used,
# the rest are fallbacks OpenRouter tries if it is rate-limited or down.
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# Free models are often rate-limited or slow; mix providers in the list so a
# fallback is usually free. (Tested 2026-09: nvidia/nemotron-3.5-lightning:free hung.)
# LLM_MODEL=google/gemma-4-31b-it:free,dots-studio/dots-3-note-preview:free,google/gemma-4-26b-a4b-it:free
# LLM_VISION_MODEL=google/gemma-4-31b-it:free,dots-studio/dots-3-note-preview:free,google/gemma-4-26b-a4b-it:free

# Per-request timeout in ms (default 60000). Free models can be slow.
# LLM_TIMEOUT_MS=120000

# Where project data lives
DATA_DIR=./data
